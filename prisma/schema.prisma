// ==================== DOCUMENTOS / ANEXOS (upload de PDF) ====================
// Modelo genérico de anexo, reutilizável por qualquer módulo (PGR, PCMSO, LTCAT,
// AET, LIP, PPP, ASO, Ordem de Serviço, Licenças, Condicionantes, IBAMA, Resíduos,
// Produtos Químicos, Certificações, Taxas, Documentos Legais...).
// entidade = nome do módulo (ex: "PGR"), entidadeId = id do registro do módulo.
model DocumentoAnexo {
  id           String            @id @default(cuid())
  entidade     String
  entidadeId   String
  nome         String
  tipo         String
  arquivoNome  String
  arquivoUrl   String
  tamanho      Int
  mimeType     String
  usuarioId    String?
  observacao   String?
  status       StatusAnexo       @default(ATIVO)
  versao       Int               @default(1)
  substituiId  String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  usuario      User?             @relation(fields: [usuarioId], references: [id])
  substitui    DocumentoAnexo?   @relation("HistoricoAnexo", fields: [substituiId], references: [id])
  substituidoPor DocumentoAnexo[] @relation("HistoricoAnexo")

  @@index([entidade, entidadeId])
}

enum StatusAnexo {
  ATIVO
  INATIVO
}

