generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==================== AUTH ====================
model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  role          UserRole  @default(ANALISTA_TST)
  perfilId      String?
  empresaId     String?
  unidadeId     String?
  ativo         Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  perfil        Perfil?   @relation(fields: [perfilId], references: [id])
  empresa       Empresa?  @relation(fields: [empresaId], references: [id])
  unidade       Unidade?  @relation(fields: [unidadeId], references: [id])
  accounts      Account[]
  sessions      Session[]
  pendencias    Pendencia[]
  historicos    Historico[]
  documentos    DocumentoAnexo[]
  movimentosEstoqueEPI EstoqueEPI[]
}

model Perfil {
  id         String   @id @default(cuid())
  nome       String   @unique
  descricao  String?
  permissoes String[]
  ativo      Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  usuarios   User[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

enum UserRole {
  ADMINISTRADOR
  GERENTE
  COORDENADOR
  ANALISTA_TST
  ANALISTA_MEIO_AMBIENTE
  CONSULTA
}

// ==================== EMPRESA / UNIDADE ====================
model Empresa {
  id                   String      @id @default(cuid())
  codigo               String      @unique
  razaoSocial          String
  cnpj                 String      @unique
  status               StatusGeral @default(ATIVO)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  unidades             Unidade[]
  certificacoes        Certificacao[]
  taxas                Taxa[]
  documentosLegais     DocumentoLegal[]
  licencasAmbientais   LicencaAmbiental[]
  pendencias           Pendencia[]
  treinamentos         Treinamento[]
  acidentes            Acidente[]
  inspecoes            InspecaoSeguranca[]
  pgrs                 PGR[]
  pcmsos               PCMSO[]
  ltcats               LTCAT[]
  ppps                 PPP[]
  inventariosRiscos    InventarioRisco[]
  residuos             ControleResiduo[]
  produtosQuimicos     ProdutoQuimico[]
  registrosIBAMA       RegistroIBAMA[]
  monitoramentos       MonitoramentoAmbiental[]
  ordensServico        OrdemServico[]
  aets                 AET[]
  lips                 LIP[]
  comunicacoes         ComunicacaoSST[]
  direitosRecusa       DireitoRecusa[]
  extintores           Extintor[]
  equipamentosPressao  EquipamentoPressao[]
  estoqueEPI           EstoqueEPI[]
  solicitacoesCompra   SolicitacaoCompraEPI[]
  cipaas               Cipaa[]
  reunioesCipa         ReuniaoCipaa[]
  cursosCipa           CursoCipaa[]
  pgrsAmbiental        PGRSAmbiental[]
  certificadosDest     CertificadoDestinacao[]
  coletasSeletivas     ColetaSeletiva[]
  recursosHidricos     RecursoHidrico[]
  avcbs                AVCB[]
  brigadas             BrigadaIncendio[]
  simulados            SimuladoIncendio[]
  usuarios             User[]
  fichasEPI            FichaEntregaEPI[]
  epis                 EPI[]
}

model Unidade {
  id                   String      @id @default(cuid())
  empresaId            String
  nome                 String
  cidade               String
  uf                   String
  responsavelTST       String?
  responsavelMeioAmb   String?
  status               StatusGeral @default(ATIVO)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  empresa              Empresa     @relation(fields: [empresaId], references: [id])
  colaboradores        Colaborador[]
  certificacoes        Certificacao[]
  taxas                Taxa[]
  documentosLegais     DocumentoLegal[]
  licencasAmbientais   LicencaAmbiental[]
  pendencias           Pendencia[]
  treinamentos         Treinamento[]
  inspecoes            InspecaoSeguranca[]
  pgrs                 PGR[]
  pcmsos               PCMSO[]
  ltcats               LTCAT[]
  ppps                 PPP[]
  inventariosRiscos    InventarioRisco[]
  residuos             ControleResiduo[]
  registrosIBAMA       RegistroIBAMA[]
  monitoramentos       MonitoramentoAmbiental[]
  ordensServico        OrdemServico[]
  aets                 AET[]
  lips                 LIP[]
  comunicacoes         ComunicacaoSST[]
  extintores           Extintor[]
  equipamentosPressao  EquipamentoPressao[]
  cipaas               Cipaa[]
  pgrsAmbiental        PGRSAmbiental[]
  coletasSeletivas     ColetaSeletiva[]
  recursosHidricos     RecursoHidrico[]
  avcbs                AVCB[]
  brigadas             BrigadaIncendio[]
  simulados            SimuladoIncendio[]
  certificadosDest     CertificadoDestinacao[]
  usuarios             User[]
  fichasEPI            FichaEntregaEPI[]
}

enum StatusGeral {
  ATIVO
  INATIVO
  ARQUIVADO
}

// ==================== COLABORADOR ====================
model Colaborador {
  id            String    @id @default(cuid())
  nome          String
  cpf           String    @unique
  matricula     String?
  unidadeId     String
  setor         String
  funcao        String
  admissao      DateTime
  status        StatusColaborador @default(ATIVO)
  riscos        String[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  unidade       Unidade   @relation(fields: [unidadeId], references: [id])
  asos          ASO[]
  epis          EntregaEPI[]
  fichasEPI     FichaEntregaEPI[]
  treinamentos  ColaboradorTreinamento[]
  ppps          PPP[]
  ordensServico  OrdemServico[]
  direitosRecusa DireitoRecusa[]
  membrosCipa    MembroCipaa[]
  cursosCipa     CursoCipaa[]
}

enum StatusColaborador {
  ATIVO
  INATIVO
  DEMITIDO
  AFASTADO
}

// ==================== TST ====================
model EPI {
  id                  String      @id @default(cuid())
  empresaId           String?
  nome                String
  ca                  String
  tipo                String
  validade            DateTime?
  status              StatusGeral @default(ATIVO)
  codigoInterno       String?
  codigoBarras        String?
  descricao           String?
  categoria           String?
  fabricante          String?
  modelo              String?
  tamanho             String?
  cor                 String?
  unidadeMedida       String?     @default("UN")
  quantidadeEstoque   Int         @default(0)
  estoqueMinimo       Int         @default(0)
  localizacao         String?
  fornecedor          String?
  valorUnitario       Float?
  lote                String?
  dataCompra          DateTime?
  dataEntrada         DateTime?
  observacoes         String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  empresa            Empresa?    @relation(fields: [empresaId], references: [id])
  entregas           EntregaEPI[]
  estoqueMovimentos  EstoqueEPI[]
  solicitacoes       SolicitacaoCompraEPI[]

  @@unique([empresaId, ca])
}

model EntregaEPI {
  id                    String    @id @default(cuid())
  fichaId               String?
  colaboradorId         String
  epiId                 String
  dataEntrega           DateTime
  dataVencimento        DateTime?
  quantidade            Int       @default(1)
  quantidadeDevolvida   Int       @default(0)
  anexo                 String?
  observacao            String?
  ativo                 Boolean   @default(true)
  createdAt             DateTime  @default(now())
  ficha           FichaEntregaEPI? @relation(fields: [fichaId], references: [id])
  colaborador     Colaborador @relation(fields: [colaboradorId], references: [id])
  epi             EPI         @relation(fields: [epiId], references: [id])
  movimentosEstoque EstoqueEPI[]
}

enum StatusFichaEPI {
  ATIVA
  INATIVA
}

model FichaEntregaEPI {
  id            String         @id @default(cuid())
  colaboradorId String
  empresaId     String
  unidadeId     String
  dataEntrega   DateTime
  observacao    String?
  status        StatusFichaEPI @default(ATIVA)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  colaborador   Colaborador    @relation(fields: [colaboradorId], references: [id])
  empresa       Empresa        @relation(fields: [empresaId], references: [id])
  unidade       Unidade        @relation(fields: [unidadeId], references: [id])
  itens         EntregaEPI[]
  movimentosEstoque EstoqueEPI[]
}

model ASO {
  id              String    @id @default(cuid())
  colaboradorId   String
  tipo            TipoASO
  dataExame       DateTime
  dataVencimento  DateTime?
  resultado       ResultadoASO @default(APTO)
  medico          String?
  crm             String?
  anexo           String?
  observacao      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  colaborador     Colaborador @relation(fields: [colaboradorId], references: [id])
}

enum TipoASO {
  ADMISSIONAL
  PERIODICO
  RETORNO
  MUDANCA_RISCO
  DEMISSIONAL
}

enum ResultadoASO {
  APTO
  INAPTO
  APTO_COM_RESTRICAO
}

model Treinamento {
  id                   String    @id @default(cuid())
  nome                 String
  tipo                 String
  normaRegulamentadora String?
  empresaId            String
  unidadeId            String
  dataRealizacao       DateTime
  dataVencimento       DateTime?
  cargaHoraria         Float?
  instrutor            String?
  local                String?
  anexo                String?
  observacao           String?
  status               StatusGeral @default(ATIVO)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  empresa              Empresa   @relation(fields: [empresaId], references: [id])
  unidade              Unidade   @relation(fields: [unidadeId], references: [id])
  colaboradores        ColaboradorTreinamento[]
}

model ColaboradorTreinamento {
  id              String      @id @default(cuid())
  colaboradorId   String
  treinamentoId   String
  colaborador     Colaborador @relation(fields: [colaboradorId], references: [id])
  treinamento     Treinamento @relation(fields: [treinamentoId], references: [id])
  @@unique([colaboradorId, treinamentoId])
}

model Acidente {
  id               String         @id @default(cuid())
  empresaId        String
  data             DateTime
  local            String
  descricao        String
  tipologia        TipoAcidente
  cat              Boolean        @default(false)
  numeroCat        String?
  dataCat          DateTime?
  eSocial          Boolean        @default(false)
  eSocialProtocolo String?
  diasPerdidos     Int?
  investigacao     String?
  planoAcao        String?
  anexo            String?
  status           StatusAcidente @default(ABERTO)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  empresa          Empresa        @relation(fields: [empresaId], references: [id])
}

enum TipoAcidente {
  TIPICO
  TRAJETO
  DOENCA_OCUPACIONAL
}

enum StatusAcidente {
  ABERTO
  EM_INVESTIGACAO
  CONCLUIDO
}

model InspecaoSeguranca {
  id              String    @id @default(cuid())
  empresaId       String
  unidadeId       String
  titulo          String
  dataInspecao    DateTime
  responsavel     String
  resultado       String?
  naoConformidades String?
  anexo           String?
  status          StatusInspecao @default(ABERTA)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  empresa         Empresa   @relation(fields: [empresaId], references: [id])
  unidade         Unidade   @relation(fields: [unidadeId], references: [id])
}

enum StatusInspecao {
  ABERTA
  EM_ANDAMENTO
  CONCLUIDA
}

// ==================== MEIO AMBIENTE ====================
model LicencaAmbiental {
  id              String    @id @default(cuid())
  empresaId       String
  unidadeId       String
  tipo            TipoLicenca
  orgao           String
  numero          String?
  emissao         DateTime?
  vencimento      DateTime
  responsavel     String?
  condicionantes  String?
  anexo           String?
  status          StatusDocumento @default(VIGENTE)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  empresa         Empresa   @relation(fields: [empresaId], references: [id])
  unidade         Unidade   @relation(fields: [unidadeId], references: [id])
  itensCondicionantes  Condicionante[]
}

enum TipoLicenca {
  LP
  LI
  LO
  LAS
  OUTORGA
  CTF_IBAMA
  AUTORIZACAO
  OUTRO
}

enum SituacaoResiduo {
  GERADO
  AGUARDANDO_COLETA
  COLETADO
  DESTINADO
}

model ControleResiduo {
  id                String          @id @default(cuid())
  empresaId         String?
  unidadeId         String?
  descricao         String
  tipoResiduo       String?
  classificacao     String?
  codigoIBAMA       String?
  classeRisco       String?
  origem            String?
  setorGerador      String?
  quantidade        Float
  unidadeMedida     String
  peso              Float?
  formaArmazenamento String?
  dataGeracao       DateTime
  dataColeta        DateTime?
  dataDestinacao    DateTime?
  destinacao        String
  empresaColetora   String?
  coletorId         String?
  responsavel       String?
  situacao          SituacaoResiduo @default(GERADO)
  mtr               String?
  certificadoDest   String?
  anexo             String?
  observacao        String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  empresa           Empresa?        @relation(fields: [empresaId], references: [id])
  unidade           Unidade?        @relation(fields: [unidadeId], references: [id])
  coletor           EmpresaColetora? @relation(fields: [coletorId], references: [id])
}

model ProdutoQuimico {
  id          String    @id @default(cuid())
  empresaId   String?
  nome        String
  cas         String?
  fornecedor  String?
  fispq       String?
  riscos      String[]
  armazenagem String?
  epi         String[]
  observacao  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  empresa     Empresa?  @relation(fields: [empresaId], references: [id])
}

model RelatorioAmbiental {
  id          String    @id @default(cuid())
  titulo      String
  tipo        String
  periodo     String
  orgao       String?
  dataEnvio   DateTime?
  prazo       DateTime?
  responsavel String?
  anexo       String?
  status      StatusDocumento @default(VIGENTE)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Condicionante {
  id               String           @id @default(cuid())
  licencaId        String
  descricao        String
  prazo            DateTime?
  periodicidade    String?
  responsavel      String?
  evidencia        String?
  status           StatusCondicionante @default(PENDENTE)
  observacao       String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  licenca          LicencaAmbiental @relation(fields: [licencaId], references: [id], onDelete: Cascade)
}

enum StatusCondicionante {
  PENDENTE
  EM_DIA
  ATRASADA
  CONCLUIDA
}

model RegistroIBAMA {
  id                String    @id @default(cuid())
  empresaId         String
  unidadeId         String?
  numeroCTF         String?
  certificadoReg    String?
  validadeCR        DateTime?
  periodoRAPP       String?
  dataEnvioRAPP     DateTime?
  protocolo         String?
  responsavel       String?
  observacao        String?
  status            StatusDocumento @default(VIGENTE)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  empresa           Empresa   @relation(fields: [empresaId], references: [id])
  unidade           Unidade?  @relation(fields: [unidadeId], references: [id])
}

model MonitoramentoAmbiental {
  id              String              @id @default(cuid())
  empresaId       String
  unidadeId       String
  tipo            TipoMonitoramento
  parametro       String
  resultado       String?
  unidadeMedida   String?
  limitePermitido String?
  conformidade    Boolean?
  dataColeta      DateTime
  dataProxima     DateTime?
  laboratorio     String?
  responsavel     String?
  anexo           String?
  observacao      String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  empresa         Empresa             @relation(fields: [empresaId], references: [id])
  unidade         Unidade             @relation(fields: [unidadeId], references: [id])
}

enum TipoMonitoramento {
  EFLUENTE_LIQUIDO
  EMISSAO_ATMOSFERICA
  RUIDO_AMBIENTAL
  AGUA_SUBTERRANEA
  SOLO
  OUTRO
}

enum StatusDocumento {
  VIGENTE
  VENCIDO
  A_VENCER
  CANCELADO
  ARQUIVADO
}

// ==================== CERTIFICACOES ====================
model Certificacao {
  id              String    @id @default(cuid())
  tipo            String
  orgaoCertificador String
  empresaId       String
  unidadeId       String
  emissao         DateTime?
  vencimento      DateTime
  responsavel     String?
  anexo           String?
  alertaDias      Int       @default(30)
  status          StatusDocumento @default(VIGENTE)
  observacao      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  empresa         Empresa   @relation(fields: [empresaId], references: [id])
  unidade         Unidade   @relation(fields: [unidadeId], references: [id])
}

// ==================== TAXAS ====================
model Taxa {
  id              String    @id @default(cuid())
  tipo            String
  orgao           String
  empresaId       String
  unidadeId       String
  competencia     String?
  vencimento      DateTime
  valor           Decimal?
  status          StatusTaxa @default(PENDENTE)
  comprovante     String?
  responsavel     String?
  observacao      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  empresa         Empresa   @relation(fields: [empresaId], references: [id])
  unidade         Unidade   @relation(fields: [unidadeId], references: [id])
}

enum StatusTaxa {
  PENDENTE
  PAGO
  VENCIDO
  CANCELADO
}

// ==================== DOCUMENTOS LEGAIS ====================
model DocumentoLegal {
  id              String    @id @default(cuid())
  nome            String
  tipo            TipoDocumentoLegal
  empresaId       String
  unidadeId       String
  emissao         DateTime?
  vencimento      DateTime?
  responsavel     String?
  anexo           String?
  status          StatusDocumento @default(VIGENTE)
  observacao      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  empresa         Empresa   @relation(fields: [empresaId], references: [id])
  unidade         Unidade   @relation(fields: [unidadeId], references: [id])
}

enum TipoDocumentoLegal {
  PGR
  PCMSO
  LTCAT
  PPP
  LAUDO_INSALUBRIDADE
  LAUDO_PERICULOSIDADE
  LAUDO_ERGONOMICO
  LICENCA_AMBIENTAL
  CERTIDAO_NEGATIVA
  CTF_APP_IBAMA
  AVCB
  ALVARA
  OUTRO
}

// ==================== PENDENCIAS ====================
model Pendencia {
  id              String    @id @default(cuid())
  descricao       String
  origem          OrigemPendencia
  empresaId       String
  unidadeId       String?
  responsavelId   String?
  prazo           DateTime
  prioridade      Prioridade @default(MEDIA)
  status          StatusPendencia @default(ABERTA)
  evidencia       String?
  observacao      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  empresa         Empresa   @relation(fields: [empresaId], references: [id])
  unidade         Unidade?  @relation(fields: [unidadeId], references: [id])
  responsavel     User?     @relation(fields: [responsavelId], references: [id])
}

enum OrigemPendencia {
  TST
  MEIO_AMBIENTE
  CERTIFICACAO
  TAXA
  AUDITORIA
  DOCUMENTO_LEGAL
}

enum Prioridade {
  BAIXA
  MEDIA
  ALTA
  CRITICA
}

enum StatusPendencia {
  ABERTA
  EM_ANDAMENTO
  CONCLUIDA
  VENCIDA
  CANCELADA
}

// ==================== HISTORICO ====================
model Historico {
  id          String    @id @default(cuid())
  entidade    String
  entidadeId  String
  acao        String
  descricao   String?
  usuarioId   String?
  createdAt   DateTime  @default(now())
  usuario     User?     @relation(fields: [usuarioId], references: [id])
}

// ==================== SST GESTAO ====================

model PGR {
  id                  String          @id @default(cuid())
  empresaId           String
  unidadeId           String
  versao              String
  dataEmissao         DateTime
  dataRevisao         DateTime?
  responsavelTecnico  String
  crea                String?
  status              StatusDocumento @default(VIGENTE)
  observacao          String?
  anexos              String[]
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  empresa             Empresa         @relation(fields: [empresaId], references: [id])
  unidade             Unidade         @relation(fields: [unidadeId], references: [id])
  revisoes            PGRRevisao[]
  inventariosRiscos   InventarioRisco[]
}

model PGRRevisao {
  id          String   @id @default(cuid())
  pgrId       String
  versao      String
  dataRevisao DateTime
  descricao   String?
  responsavel String?
  createdAt   DateTime @default(now())
  pgr         PGR      @relation(fields: [pgrId], references: [id], onDelete: Cascade)
}

model PCMSO {
  id                  String          @id @default(cuid())
  empresaId           String
  unidadeId           String
  medicoResponsavel   String
  crm                 String?
  clinica             String?
  vigenciaInicial     DateTime
  vigenciaFinal       DateTime?
  status              StatusDocumento @default(VIGENTE)
  observacao          String?
  anexos              String[]
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  empresa             Empresa         @relation(fields: [empresaId], references: [id])
  unidade             Unidade         @relation(fields: [unidadeId], references: [id])
  examesPrevistos     ExamePrevisto[]
}

model ExamePrevisto {
  id             String   @id @default(cuid())
  pcmsoId        String
  tipo           String
  periodicidade  String
  funcoes        String[]
  createdAt      DateTime @default(now())
  pcmso          PCMSO    @relation(fields: [pcmsoId], references: [id], onDelete: Cascade)
}

model LTCAT {
  id                  String          @id @default(cuid())
  empresaId           String
  unidadeId           String
  responsavelTecnico  String
  crea                String?
  art                 String?
  dataEmissao         DateTime
  vigencia            DateTime?
  ambientesAvaliados  String?
  agentesNocivos      String[]
  status              StatusDocumento @default(VIGENTE)
  observacao          String?
  anexos              String[]
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  empresa             Empresa         @relation(fields: [empresaId], references: [id])
  unidade             Unidade         @relation(fields: [unidadeId], references: [id])
}

model PPP {
